{
  "name": "btmap-web",
  "version": "2.0.0",
  "description": "Open-source telecommunications and cellular RF intelligence platform for mapping base transceiver stations across Poland and Central Europe.",
  "license": "MIT",
  "author": "Jerzy Janiszewski",
  "homepage": "https://github.com/JUreK646/btmapv2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUreK646/btmapv2.git"
  },
  "keywords": [
    "telecom",
    "gsm",
    "lte",
    "5g",
    "cellular",
    "rf-engineering",
    "leaflet",
    "open-source",
    "poland"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types server/start.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "sync:uke": "node --experimental-strip-types scripts/sync_uke.ts",
    "sync:si2pem": "node --experimental-strip-types scripts/sync_si2pem.ts",
    "import:kml": "python scripts/import_kml.py"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.1"
  }
}
