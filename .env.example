PORT=3001
HOST=127.0.0.1
BTMAP_DB=data/btmap.sqlite
# Production: actual public hostname (without scheme) and HTTPS reverse proxy.
# PUBLIC_HOST=btmap.pl
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional Google Satellite: browser API key, restricted to your website and Map Tiles API.
# Enable Map Tiles API in your own Google Cloud project before setting this value.
# VITE_GOOGLE_MAPS_API_KEY=

# Logowanie przez Google (OAuth 2.0 / Google Identity Services)
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Typ danych logowania: Aplikacja internetowa
# Autoryzowany identyfikator URI przekierowania: http://localhost:5174/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
